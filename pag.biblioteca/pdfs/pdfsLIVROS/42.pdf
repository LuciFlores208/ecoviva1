     <rdf:li>UN Photo/Kibae Park</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Access to Water and Sanitation</rdf:li>
    </rdf:Alt>
   </dc:title>

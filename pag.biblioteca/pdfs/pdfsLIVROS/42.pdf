   <photoshop:SupplementalCategories>
    <rdf:Bag>
     <rdf:li>Y</rdf:li>
    </rdf:Bag>
   </photoshop:SupplementalCategories>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">On November 24, 2013 UN peacekeepers from Ghana Engineering Contingent started painting the walls of a public school in Taliko, a marginalized neighborhood of Bamako. The work, that lasted about 10 days and that was part of the UN Day celebration, was meant to rehabilitate the school that hosted tens of displaced families victims of heavy flooding in July.&#xA;</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:creator>
    <rdf:Seq>
     <rdf:li>UN Photo/Marco Dormino</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Peacekeeping - MINUSMA</rdf:li>
    </rdf:Alt>
   </dc:title>
